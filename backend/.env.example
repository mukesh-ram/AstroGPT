# ─────────────────────────────────────────────────────────────────────────────
# AstroGPT Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini API Key (REQUIRED) ──────────────────────────────────────────
# Get yours free at: https://aistudio.google.com/apikey
# The SDK reads GOOGLE_API_KEY automatically. GEMINI_API_KEY is a legacy alias.
GOOGLE_API_KEY=your_google_api_key_here

# ── Firebase Service Account (OPTIONAL) ───────────────────────────────────────
# Without this, the app works fully — sessions are just in-memory.
# To enable Firestore persistence:
#   1. Go to https://console.firebase.google.com → your project → Project Settings
#   2. Service Accounts → Generate new private key → download JSON
#   3. Paste the ENTIRE JSON content as a single line below:
FIREBASE_CREDENTIALS_JSON=

# ── CORS Origins (REQUIRED for production) ────────────────────────────────────
# Comma-separated list of allowed origins. Add your Vercel URL here.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://astrogpt.vercel.app
